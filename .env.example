# ~/.config/tgbot/.env is for secrets. `tgbot key init` writes the key for you.
# Preferences (default bot/chat, color, timeout, API URL) belong in ~/.config/tgbot/config.toml.

# Key that encrypts saved bot tokens (generated by `tgbot key init`; back it up!)
TGBOT_SECRET_KEY=

# Optional overrides (environment variables win over this file, this file over config.toml)
# TGBOT_DEFAULT_BOT=main                 # bot alias used without --bot
# TGBOT_DEFAULT_CHAT=me                  # target used when none is given
# TGBOT_CONFIG_DIR=~/.config/tgbot       # where .env, config.toml and tgbot.db live (env var only)
# TGBOT_PLAIN=true                       # disable Rich styling
# TGBOT_TIMEOUT=30                       # HTTP timeout, seconds
# TGBOT_API_URL=https://api.telegram.org # e.g. a local Bot API server
