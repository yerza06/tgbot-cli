# Copy to ~/.config/tgbot/.env (or export the variables). `tgbot token set` writes the token for you.

# Bot token from @BotFather
TGBOT_BOT_TOKEN=123456789:AAExampleExampleExampleExampleExam

# Optional
# TGBOT_CONFIG_DIR=~/.config/tgbot       # where .env and tgbot.db live (env var only)
# TGBOT_PLAIN=true                       # disable Rich styling
# TGBOT_TIMEOUT=30                       # HTTP timeout, seconds
# TGBOT_API_URL=https://api.telegram.org # e.g. a local Bot API server
